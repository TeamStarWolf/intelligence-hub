{
  "vocab": "region",
  "version": "2026.11.1",
  "multi": true,
  "description": "Places a row is tied to, each with a role. Values are ISO 3166-1 alpha-2 country codes, EU for the European Union, and M49-<code> for UN M49 regions. Names match case-sensitively as whole words.",
  "roles": [
    {
      "value": "publisher",
      "definition": "The country or union of the publishing agency or vendor, from config/sources.json. Confidence high."
    },
    {
      "value": "mentioned",
      "definition": "The headline names the place or its demonym. A headline mention does not say whether the place is a target, an origin or neither. Confidence medium."
    },
    {
      "value": "target",
      "definition": "A structured field names a targeted or deployment country (for example a CISA ICS CSAF deployment note). Reserved for the history adapters."
    },
    {
      "value": "vendor-hq",
      "definition": "A structured field names the vendor's headquarters country (CISA ICS CSAF). Reserved for the history adapters."
    }
  ],
