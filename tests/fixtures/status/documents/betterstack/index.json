  {
   "id": "5947700",
   "type": "status_update",
   "attributes": {
    "message": "Our image catalog is almost completely rebuilt with updated certificates. However, catalog synchronization and publishing are still underway. Check your registry often to see the build status of your own images. Official communications are coming soon with detailed guidance on impact and workarounds. Check your communication opt-ins in the Chainguard Console to ensure you see them.",
    "published_at": "2026-10-20T21:59:51.130Z",
    "published_at_timezone": "Eastern Time (US & Canada)",
