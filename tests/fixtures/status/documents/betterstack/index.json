      "status": "degraded"
     }
    ]
   }
  },
  {
   "id": "5963740",
   "type": "status_update",
   "attributes": {
    "message": "Updated Oct 22, 2026 at 5:30pm CDT\n\nUpdated PHP images have been delivered to all customer registries. All Chainguard PHP images are now built on the official PHP releases: 8.2.35, 8.3.36, 8.4.27 and 8.5.12. The earlier packages (php-8.2 8.2.34-r4, php-8.3 8.3.35-r4, php-8.4 8.4.26-r4, php-8.5 8.5.11-r4, and the matching frankenphp packages) contain the same fix, so an image on either set of versi",
    "published_at": "2026-10-22T22:52:00.000Z",
    "published_at_timezone": "Dublin",
    "notify_subscribers": true,
    "affected_resources": [
     {
      "status_page_resource_id": "8961850",
      "status": "resolved"
     }
    ]
   }
  },
