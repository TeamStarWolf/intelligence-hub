  },
  {
   "id": "5948072",
   "type": "status_update",
   "attributes": {
    "message": "We continue rebuilding all Chainguard images onto the updated certificate bundle that removes trust in the compromised eMudhra certificate authorities. Nearly all images are rebuilt, and rebuilt images are syncing into customer registries as they complete. We have published a remediation guide with the steps to update, confirm the fix, and handle applications that bundle their own certificates:\n\n[",
    "published_at": "2026-10-20T23:58:09.128Z",
    "published_at_timezone": "Pacific Time (US & Canada)",
    "notify_subscribers": true,
    "affected_resources": [
     {
      "status_page_resource_id": "8961850",
      "status": "degraded"
     }
    ]
   }
  },
  {
   "id": "5946484",
   "type": "status_update",
   "attributes": {
    "message": "We are aware of the recently disclosed compromise of the eMudhra emSign G3 certificate authority, which has been distrusted across the ecosystem (including by Mozilla and the Go project). Our services are operating normally. As a precaution we are actively updating all Chainguard container images to remove trust in the affected certificate authority, matching the wider ecosystem.",
    "published_at": "2026-10-20T17:09:31.570Z",
    "published_at_timezone": "Pacific Time (US & Canada)",
    "notify_subscribers": true,
    "affected_resources": [
     {
